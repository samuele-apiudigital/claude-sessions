#!/bin/sh
# Usage: claude-sessions [-a|--all] [-w|--watch] [-j|--json] [-s|--serve [PORT]]
#   default: live sessions only; -a also lists recent finished transcripts (last 24h)
#   -s serves the dashboard as a web page on 127.0.0.1 (default port 7421, or $CS_PORT)
export CS_SELF="$0"
exec python3 -I - "$@" <<'PY'
import json, os, sys, glob, time, subprocess, shutil, re
from datetime import datetime
args = sys.argv[1:]
ISTTY = sys.stdout.isatty()
FRAME = 0
SEL = None
TILES = []
MSG = ("", 0.0)
show_all = any(a in ("-a", "--all") for a in args)
as_json = any(a in ("-j", "--json") for a in args)
table = any(a in ("-t", "--table") for a in args)
watch = any(a in ("-w", "--watch") for a in args)
HOME = os.path.expanduser("~/.claude")
WINDOW = int(os.environ.get("CLAUDE_CTX_WINDOW", "0"))
CHAT_DIR = f"{HOME}/state/cs-chat"
CHAT_MODEL = os.environ.get("CS_CHAT_MODEL", "haiku")
CHAT_ROWS = int(os.environ.get("CS_CHAT_ROWS", "8"))
AGENT_ROWS = max(2, int(os.environ.get("CS_AGENT_ROWS", "4")))
REPO_ROOTS = [r for r in (os.path.expanduser(x).rstrip("/") for x in os.environ.get("CS_REPO_ROOTS", "~/Projects").split(":")) if os.path.isdir(r)]
CHAT, CHAT_SID, CHAT_PROC, REPOS, INPUT, CHAT_T0 = [], None, None, None, None, 0.0

def alive(pid):
    try: os.kill(pid, 0); return True
    except OSError: return False

def etime(pid):
    try: return subprocess.check_output(["ps", "-p", str(pid), "-o", "etime="], text=True).strip()
    except Exception: return "-"

def fmt(n):
    return f"{n/1e6:.1f}M" if n >= 1e6 else f"{n/1e3:.0f}k" if n >= 1e3 else str(n)

def ago(ms):
    s = max(0, int(time.time() - ms/1000))
    return f"{s}s" if s < 60 else f"{s//60}m" if s < 3600 else f"{s//3600}h{s%3600//60:02d}m" if s < 86400 else f"{s//86400}d"

def dur(sec):
    sec = int(max(0, sec))
    return f"{sec}s" if sec < 60 else f"{sec//60}m{sec%60:02d}s" if sec < 3600 else f"{sec//3600}h{sec%3600//60:02d}m"

def epoch(ts):
    try: return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except Exception: return None

def tag(text, name):
    m = re.search(f"<{name}>(.*?)</{name}>", text, re.S)
    return m.group(1).strip() if m else None

def transcript(sid):
    m = glob.glob(f"{HOME}/projects/*/{sid}.jsonl")
    return m[0] if m else None

def stats(path):
    s = dict(model="-", ctx=0, peak=0, turns=0, out=0, inp=0, cread=0, ccreate=0, tools=0, hist=[], title="", branch="", wd="", ultra=False, prompt="", cur_task="", done_task="", subjects=None, ncreate=0, first=None, last=None, agents=[])
    s["subjects"] = {}
    if not path: return s
    ag, by_task, pend = {}, {}, {}
    def notified(text, ts):
        for blk in text.split("<task-notification>")[1:]:
            a = ag.get(by_task.get(tag(blk, "task-id"))) or ag.get(tag(blk, "tool-use-id"))
            if not a: continue
            a["wait"] = "background work" in f"{tag(blk, 'summary')} {tag(blk, 'note')}"
            if a["state"] == "running" and not a["wait"]:
                a["state"], a["t1"] = tag(blk, "status") or "completed", epoch(ts)
    with open(path, errors="ignore") as f:
        for line in f:
            try: d = json.loads(line)
            except Exception: continue
            t = d.get("type")
            if t == "queue-operation" and "<task-notification>" in str(d.get("content") or ""):
                notified(str(d["content"]), d.get("timestamp"))
            if t == "ai-title": s["title"] = d.get("aiTitle", "")
            if t == "attachment":
                at = (d.get("attachment") or {}).get("type")
                if at == "ultra_effort_enter": s["ultra"] = True
                elif at == "ultra_effort_exit": s["ultra"] = False
            if t == "last-prompt": s["prompt"] = d.get("lastPrompt", "") or s["prompt"]
            if d.get("gitBranch"): s["branch"] = d["gitBranch"]
            if d.get("cwd"): s["wd"] = d["cwd"]
            ts = d.get("timestamp")
            if ts:
                s["first"] = s["first"] or ts
                s["last"] = ts
            if t == "user" and not d.get("isSidechain"):
                c = d.get("message", {}).get("content")
                if isinstance(c, str) or (isinstance(c, list) and any(x.get("type") == "text" for x in c if isinstance(x, dict))):
                    s["turns"] += 1
                text = c if isinstance(c, str) else " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text") if isinstance(c, list) else ""
                if "<task-notification>" in text: notified(text, ts)
                res = d.get("toolUseResult") if isinstance(d.get("toolUseResult"), dict) else {}
                for x in c if isinstance(c, list) else []:
                    if not (isinstance(x, dict) and x.get("type") == "tool_result"): continue
                    uid = x.get("tool_use_id")
                    if uid in ag:
                        a = ag[uid]
                        if res.get("isAsync") or res.get("status") == "async_launched":
                            a["aid"], a["run"] = res.get("agentId"), res.get("runId")
                            if a["kind"] == "workflow": a["desc"] = res.get("workflowName") or a["desc"]
                            for k in (res.get("agentId"), res.get("taskId")):
                                if k: by_task[k] = uid
                        elif a["state"] == "running":
                            a["state"], a["t1"] = "failed" if x.get("is_error") else "completed", epoch(ts)
                    elif uid in pend:
                        nm, target = pend.pop(uid)
                        a = ag.get(by_task.get(target))
                        if not a or x.get("is_error"): continue
                        if nm == "TaskStop": a["state"], a["t1"] = "stopped", epoch(ts)
                        elif res.get("resumedAgentId"): a["state"], a["t1"] = "running", None
            if t == "assistant":
                m = d.get("message", {})
                u = m.get("usage") or {}
                if m.get("model") and not m["model"].startswith("<"): s["model"] = m["model"]
                i, cr, cc, o = (u.get(k, 0) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"))
                if not d.get("isSidechain"):
                    s["ctx"] = i + cr + cc
                    s["peak"] = max(s["peak"], s["ctx"])
                    s["hist"].append(s["ctx"])
                s["inp"] += i; s["cread"] += cr; s["ccreate"] += cc; s["out"] += o
                for x in m.get("content", []):
                    if not (isinstance(x, dict) and x.get("type") == "tool_use"): continue
                    s["tools"] += 1
                    inp = x.get("input") or {}
                    nm = x.get("name")
                    if d.get("isSidechain"): pass
                    elif nm in ("Agent", "Task"):
                        ag[x["id"]] = dict(id=x["id"], kind="agent", type=inp.get("subagent_type") or "general-purpose",
                            desc=inp.get("description") or "", state="running", t0=epoch(ts), t1=None, aid=None, run=None)
                    elif nm == "Workflow":
                        mn = re.search(r"\bname:\s*['\"]([^'\"]+)", str(inp.get("script") or ""))
                        ag[x["id"]] = dict(id=x["id"], kind="workflow", type="workflow", desc=inp.get("name") or (mn.group(1) if mn else "workflow"),
                            state="running", t0=epoch(ts), t1=None, aid=None, run=None)
                    elif nm in ("TaskStop", "SendMessage"):
                        pend[x["id"]] = (nm, inp.get("task_id") or inp.get("shell_id") or inp.get("to"))
                    if nm == "TaskCreate":
                        s["ncreate"] += 1
                        s["subjects"][str(s["ncreate"])] = inp.get("subject", "")
                    elif nm == "TaskUpdate":
                        tid, st_ = str(inp.get("taskId", "")), inp.get("status")
                        text = inp.get("activeForm") or s["subjects"].get(tid, "")
                        if st_ == "in_progress":
                            s["cur_task"], s["cur_id"] = text, tid
                        elif st_ in ("completed", "deleted"):
                            s["done_task"] = s["subjects"].get(tid) or text or s["done_task"]
                            if s.get("cur_id") == tid: s["cur_task"] = ""
    s["hist"] = s["hist"][-36:]
    s["agents"] = list(ag.values())
    return s

def activity(path):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2); f.seek(max(0, f.tell() - 65536))
            raw = f.read().decode(errors="ignore")
    except (OSError, TypeError):
        return ""
    for line in reversed(raw.splitlines()):
        try: d = json.loads(line)
        except Exception: continue
        c = (d.get("message") or {}).get("content")
        if d.get("type") == "user":
            return "thinking" if isinstance(c, list) and any(isinstance(x, dict) and x.get("type") == "tool_result" for x in c) else "starting"
        if d.get("type") == "assistant":
            used = [x.get("name", "") for x in c or [] if isinstance(x, dict) and x.get("type") == "tool_use"]
            if used: return used[-1].split("__")[-1]
            return "finishing" if d["message"].get("stop_reason") == "end_turn" else "thinking"
    return "starting"

def agent_detail(path, agents, live, since):
    if not path: return
    base = os.path.join(os.path.dirname(path), os.path.basename(path)[:-6], "subagents")
    by_use = None
    for a in agents:
        if a["state"] == "running" and not (live and (a["t0"] or 0) * 1000 >= since - 5000):
            a["state"] = "lost"
        if a["kind"] == "workflow":
            started, finished, a["phase"] = set(), set(), ""
            try:
                with open(os.path.join(base, "workflows", a["run"] or "-", "journal.jsonl"), errors="ignore") as f:
                    for line in f:
                        try: e = json.loads(line)
                        except Exception: continue
                        if e.get("type") == "started":
                            started.add(e.get("key")); a["phase"] = e.get("phase") or a["phase"]
                        elif e.get("type") == "result": finished.add(e.get("key"))
            except OSError:
                pass
            a["nrun"] = len(started - finished) if a["state"] == "running" else 0
            a["ndone"] = len(started) - a["nrun"]
        elif a["state"] == "running":
            f = os.path.join(base, f"agent-{a['aid']}.jsonl") if a["aid"] else None
            if not f:
                if by_use is None:
                    by_use = {}
                    for mf in glob.glob(os.path.join(base, "agent-*.meta.json")):
                        try: by_use[json.load(open(mf)).get("toolUseId")] = mf[:-10] + ".jsonl"
                        except Exception: pass
                f = by_use.get(a["id"])
            a["act"] = activity(f)
            if a.get("wait") and a["act"] == "finishing": a["act"] = "waiting"

def collect(ended=None):
    ended = show_all if ended is None else ended
    rows, seen = [], set()
    for jf in glob.glob(f"{HOME}/sessions/*.json"):
        try: d = json.load(open(jf))
        except Exception: continue
        pid, sid = d.get("pid"), d.get("sessionId")
        live = bool(pid) and alive(pid)
        if not live and not ended: continue
        if d.get("cwd") == CHAT_DIR: continue
        seen.add(sid)
        tp = transcript(sid)
        st = stats(tp)
        agent_detail(tp, st["agents"], live, d.get("startedAt") or 0)
        rows.append(dict(sid=sid, pid=pid, live=live, status=d.get("status", "?") if live else "ended",
            name=st["title"] or d.get("name"), cwd=st["wd"] or d.get("cwd", ""), kind=d.get("kind", ""),
            entry=d.get("entrypoint", ""), version=d.get("version", ""), started=d.get("startedAt", 0),
            updated=d.get("updatedAt", 0), uptime=etime(pid) if live else "-", **st))
    if ended:
        cutoff = time.time() - 86400
        for p in glob.glob(f"{HOME}/projects/*/*.jsonl"):
            sid = os.path.basename(p)[:-6]
            if sid in seen or os.path.getmtime(p) < cutoff: continue
            st = stats(p)
            if st["wd"] == CHAT_DIR: continue
            agent_detail(p, st["agents"], False, 0)
            rows.append(dict(sid=sid, pid=None, live=False, status="ended", name=st["title"],
                cwd=st["wd"] or os.path.basename(os.path.dirname(p)), kind="", entry="", version="", started=0,
                updated=int(os.path.getmtime(p)*1000), uptime="-", **st))
    rows.sort(key=lambda r: (not r["live"], r["started"] if r["live"] else 0, -r["updated"]))
    return rows

def agent_counts(r):
    ags = r.get("agents") or []
    running = sorted((a for a in ags if a["state"] == "running"), key=lambda a: a["t0"] or 0)
    nrun = sum((a.get("nrun") or 1) if a["kind"] == "workflow" else 1 for a in running)
    ndone = sum(a.get("ndone", 0) if a["kind"] == "workflow" else a["state"] != "running" for a in ags)
    return running, nrun, ndone

def render_table(rows):
    if as_json:
        print(json.dumps(rows, indent=2)); return
    cols = shutil.get_terminal_size((160, 20)).columns
    G, Y, R, D, B, Z = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[1m", "\033[0m"
    if not ISTTY: G = Y = R = D = B = Z = ""
    print(f"{B}{'PID':<7}{'STATUS':<9}{'CONTEXT':<22}{'MODEL':<18}{'TURNS':>5} {'TOOLS':>5} {'OUT':>6} {'CACHE-R':>8} {'UP':>9} {'IDLE':>6}  SESSION{Z}")
    for r in rows:
        w = WINDOW or (1_000_000 if r["peak"] > 200_000 else 200_000)
        pct = r["ctx"] / w * 100
        n = 10; fill = min(n, round(pct / 100 * n))
        col = R if pct >= 85 else Y if pct >= 60 else G
        bar = f"{col}{'█'*fill}{D}{'░'*(n-fill)}{Z} {fmt(r['ctx']):>5} {pct:3.0f}%"
        sc = G if r["status"] == "busy" else Y if r["status"] == "idle" else D
        proj = os.path.basename(r["cwd"].rstrip("/")) or r["cwd"]
        nag = agent_counts(r)[1]
        label = f"{r['name'] or r['title'] or r['sid'][:8]} {D}[{proj}]{Z}" + (f" {Y}· {nag} agent{'s' if nag != 1 else ''}{Z}" if nag else "")
        pid = str(r["pid"] or "-")
        print(f"{pid:<7}{sc}{r['status']:<9}{Z}{bar:<{22+len(col)+len(D)+len(Z)}}{r['model'].replace('claude-',''):<18}"
              f"{r['turns']:>5} {r['tools']:>5} {fmt(r['out']):>6} {fmt(r['cread']):>8} {r['uptime']:>9} {ago(r['updated']) if r['updated'] else '-':>6}  {label}"[:cols+40])
    live = [r for r in rows if r["live"]]
    print(f"{D}{len(live)} live / {len(rows)} shown · ctx = last request input (input+cache) · window assumed {'$CLAUDE_CTX_WINDOW' if WINDOW else '200k, 1M if peak>200k'}{Z}")

import re, unicodedata
_ansi = re.compile(r"\033\[[0-9;]*m")
def vw(t):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 0 if unicodedata.combining(c) else 1 for c in _ansi.sub("", t))
def pad(t, w):
    return t + " " * max(0, w - vw(t))
def clip(t, w):
    if vw(t) <= w: return t
    o = ""
    for c in t:
        if vw(o + c) > w - 1: break
        o += c
    return o + "…"

def usage_data():
    try: return json.load(open(f"{HOME}/state/rate-limits.json"))
    except Exception: return None

def usage_line(width):
    tty = ISTTY
    C = lambda n: f"\033[{n}m" if tty else ""
    Z, D, B = C(0), C(2), C(1)
    col = lambda p: C("38;5;167") if p >= 85 else C("38;5;179") if p >= 60 else C("38;5;114")
    d = usage_data()
    if d is None:
        return f"{D} usage limits: no data yet (appears after the next status line refresh){Z}"
    rl, now = d.get("rate_limits") or {}, time.time()
    def rem(sec):
        sec = int(max(0, sec))
        dd, r = divmod(sec, 86400); hh, r = divmod(r, 3600); mm = r // 60
        return f"{dd}d{hh}h" if dd else f"{hh}h{mm:02d}m" if hh else f"{mm}m"
    parts = []
    for key, lab, fmt_t in (("five_hour", "5h", "%H:%M"), ("seven_day", "7d", "%a %H:%M")):
        w = rl.get(key)
        if not w: continue
        pct, rs = float(w.get("used_percentage") or 0), w.get("resets_at")
        if rs and rs < now:
            parts.append(f"{B}{lab}{Z} {D}window reset{Z}")
            continue
        n = 14
        f = min(n, round(pct / 100 * n))
        bar = f"{col(pct)}{'█'*f}{D}{'░'*(n-f)}{Z}"
        when = f" {D}resets{Z} {time.strftime(fmt_t, time.localtime(rs))} {D}(in {rem(rs-now)}){Z}" if rs else ""
        parts.append(f"{B}{lab}{Z} {bar} {col(pct)}{B}{pct:.0f}%{Z}{when}")
    age = rem(now - d.get("ts", now))
    sep = f"  {D}│{Z}  "
    return " " + sep.join(parts) + f"{sep}{D}updated {age} ago{Z}" if parts else f"{D} usage limits: n/a{Z}"

def render(rows):
    if as_json or table:
        return render_table(rows)
    tty = ISTTY
    C = lambda n: f"\033[{n}m" if tty else ""
    TC = lambda n: f"\033[38;5;{n}m" if tty else ""
    Z, B, D = C(0), C(1), C(2)
    CY = TC(81)
    ORANGE, GREEN, AMBER, GRAY, RED, FG = TC(173), TC(114), TC(179), TC(240), TC(167), TC(253)
    WAITGRAY, VIOLET = TC(248), TC(141)
    RAINBOW = [TC(n) for n in (196, 208, 220, 82, 45, 63, 171)]
    SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    one = lambda x: " ".join(str(x).split())
    def logo_line(i, r, text):
        if r.get("ultra") and r["live"]:
            ph = FRAME // 2
            return "".join(f"{RAINBOW[(k + ph) % len(RAINBOW)]}{c}" if c != " " else c for k, c in enumerate(text)) + Z
        return f"{ORANGE}{text}{Z}"
    cols = max(shutil.get_terminal_size((120, 20)).columns, 34)
    spark = "▁▂▃▄▅▆▇█"
    logo = [" ▐▛███▜▌  ", "▝▜█████▛▘ ", "  ▘▘ ▝▝   "]

    def state(r):
        st = r["status"]
        if st == "busy": return "RUNNING", ORANGE
        if st == "idle": return "WAITING", WAITGRAY
        if st == "ended": return "ENDED", GRAY
        return st.upper(), AMBER

    live = [r for r in rows if r["live"]]
    nrun = sum(1 for r in live if r["status"] == "busy")
    nwait = sum(1 for r in live if r["status"] == "idle")
    nother = len(live) - nrun - nwait
    nag = sum(agent_counts(r)[1] for r in live)
    head = (f" {ORANGE}{B}✻ Claude sessions{Z}   {ORANGE}●{Z} {nrun} running   {WAITGRAY}●{Z} {nwait} waiting"
            + (f"   {AMBER}●{Z} {nother} other" if nother else "")
            + (f"   {VIOLET}◆{Z} {nag} agent{'s' if nag != 1 else ''}" if nag else "")
            + f"   {D}·  {fmt(sum(r['ctx'] for r in live))} context  ·  {fmt(sum(r['out'] for r in rows))} output  ·  {time.strftime('%H:%M:%S')}{Z}")
    print(head + "\n")

    def agent_block(r, iw):
        ags = r.get("agents") or []
        if not ags: return []
        now = time.time()
        running, nrun, ndone = agent_counts(r)
        recent = sorted((a for a in ags if a["state"] not in ("running", "lost") and a["t1"] and now - a["t1"] < 60), key=lambda a: -a["t1"])
        head = (f"{D}AGENTS{Z}" + (f" {ORANGE}{B}{nrun}{Z} {D}running{Z}" if nrun else "") + (f" {D}·{Z}" if nrun and ndone else "")
                + (f" {FG}{ndone}{Z} {D}done{Z}" if ndone else ""))
        show, more = running + recent, 0
        if len(show) > AGENT_ROWS: show, more = show[:AGENT_ROWS - 1], len(show) - AGENT_ROWS + 1
        short = lambda a: {"general-purpose": "general", "claude-code-guide": "guide", "statusline-setup": "statusline"}.get(a["type"], a["type"])
        tw = min(10, max((vw(short(a)) for a in show), default=0))
        out = ["", head]
        for k, a in enumerate(show):
            on = a["state"] == "running"
            if on:
                ic = f"{ORANGE}{SPIN[(FRAME + k * 3) % 10]}{Z}"
                act = f"{a['phase'] or 'running'} {a['ndone']}/{a['ndone'] + a['nrun']}" if a["kind"] == "workflow" else a.get("act") or "starting"
                right = f"{act} {dur(now - (a['t0'] or now))}"
            else:
                ic = f"{WAITGRAY}✓{Z}" if a["state"] == "completed" else f"{RED}✗{Z}" if a["state"] == "failed" else f"{GRAY}■{Z}"
                right = f"{'done' if a['state'] == 'completed' else a['state']} {dur(a['t1'] - (a['t0'] or a['t1']))}"
            right = clip(right, max(6, iw // 3))
            left = f"{ic} {VIOLET if on else D}{pad(clip(short(a), tw), tw)}{Z} "
            mw = max(1, iw - vw(left) - vw(right) - 1)
            out.append(left + pad(f"{FG if on else D}{clip(one(a['desc']) or '-', mw)}{Z}", mw) + f" {D}{right}{Z}")
        if more: out.append(f"{D}  +{more} more{Z}")
        return out

    def make(r, W, ablock):
        iw = W - 8
        label, sc = state(r)
        busy = r["status"] == "busy"
        w = WINDOW or (1_000_000 if r["peak"] > 200_000 else 200_000)
        pct = min(100.0, r["ctx"] / w * 100)
        bc = RED if pct >= 85 else AMBER if pct >= 60 else sc if r["status"] != "ended" else GRAY
        proj = os.path.basename(r["cwd"].rstrip("/")) or r["cwd"]
        ent = {"claude-vscode": "VS Code", "cli": "CLI"}.get(r["entry"], r["entry"] or "")
        tag = clip(f"#{r['pid']}" + (f" · {ent}" if ent else "") if r["pid"] else "transcript", W - 8)
        bd = sc if r["status"] != "ended" else GRAY
        tw = iw - 11
        fill = round(pct / 100 * iw)
        bar = f"{bc}{'█'*fill}{GRAY}{'░'*(iw-fill)}{Z}"
        hist = r["hist"]
        sp = ""
        if hist:
            pts = [hist[int(i * len(hist) / iw)] for i in range(iw)]
            sp = "".join(spark[min(7, int(v / w * 8))] for v in pts)
        half = iw // 2
        def pair(l1, v1, l2, v2):
            return pad(f"{D}{l1}{Z} {FG}{v1}{Z}", half) + f"{D}{l2}{Z} {FG}{v2}{Z}"
        home = os.path.expanduser("~")
        wd = r["cwd"]
        if wd.startswith(home): wd = "~" + wd[len(home):]
        dw = iw - 5
        if vw(wd) > dw: wd = "…" + wd[-(dw - 1):]
        br = r["branch"] if r["branch"] and r["branch"] != "HEAD" else ""
        brl = f"{CY}{clip(br, dw)}{Z}" if br else f"{D}none{Z}"
        if r["status"] == "busy":
            tt = one(r["cur_task"] or r["prompt"])
            task_l = f"{ORANGE}▶{Z} {FG}{clip(tt, dw - 2)}{Z}" if tt else f"{D}working…{Z}"
        else:
            tt = one(r["done_task"] or r["prompt"])
            task_l = f"{WAITGRAY}✓{Z} {D}{clip(tt, dw - 2)}{Z}" if tt else f"{D}—{Z}"
        lines = [
            "",
            "",
            f"{logo_line(0, r, logo[0])}{B}{FG}{clip(r['name'] or r['sid'][:8], tw)}{Z}",
            f"{logo_line(1, r, logo[1])}{sc}{'●' if not busy or FRAME // 4 % 2 == 0 else '○'}{Z} {sc}{B}{label}{Z}" + (f" {sc}{'⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'[FRAME % 10]}{Z}" if busy else ""),
            logo_line(2, r, logo[2] if not busy else logo[2][::-1] if FRAME // 3 % 2 else logo[2]),
            "",
            f"{D}dir{Z}  {FG}{wd}{Z}",
            f"{D}git{Z}  {brl}",
            f"{D}task{Z} {task_l}",
            *ablock,
            "",
            pad(f"{D}CONTEXT{Z} {FG}{fmt(r['ctx'])}{D}/{fmt(w)}{Z}", iw - 4) + f"{bc}{B}{pct:3.0f}%{Z}",
            bar,
            bar,
            "",
            f"{D}MODEL{Z} {FG}{clip(r['model'].replace('claude-',''), iw-6)}{Z}",
            pair("turns", r["turns"], "tools", r["tools"]),
            pair("out", fmt(r["out"]), "cache", fmt(r["cread"])),
            pair("up", r["uptime"], "idle", ago(r["updated"]) if r["updated"] else "-"),
            "",
            "",
        ]
        nd = max(0, W - 5 - vw(tag))
        if busy and nd:
            pos = FRAME % (nd + 6) - 6
            dashes = "".join(f"{FG}{B}━{Z}{bd}" if 0 <= i - pos < 6 else "─" for i in range(nd))
        else:
            dashes = "─" * nd
        sel = r["sid"] == SEL
        TL, TR, BL, BR, HZ, VT = ("╔", "╗", "╚", "╝", "═", "║") if sel else ("╭", "╮", "╰", "╯", "─", "│")
        if sel: dashes = dashes.replace("─", "═")
        top = f"{bd}{B if sel else ''}{TL}{HZ} {D}{tag}{Z}{bd}{B if sel else ''} " + dashes + f"{TR}{Z}"
        t = [top]
        for ln in lines:
            t.append(f"{bd}{VT}{Z}   {pad(ln, iw)}   {bd}{VT}{Z}")
        t.append(f"{bd}{BL}{HZ*(W-2)}{BR}{Z}")
        return t

    avail = cols - 1
    per = max(1, avail // 52)
    base, extra = divmod(avail - (per - 1), per)
    ws = [base + (1 if j < extra else 0) for j in range(per)]
    if tty and not watch:
        sys.stdout.write("\033[H\033[2J")
    TILES.clear()
    y0 = 3
    for i in range(0, len(rows), per):
        chunk = rows[i:i+per]
        blocks = [agent_block(r, ws[j] - 8) for j, r in enumerate(chunk)]
        nb = max(map(len, blocks))
        tiles = [make(r, ws[j], blocks[j] + [""] * (nb - len(blocks[j]))) for j, r in enumerate(chunk)]
        for j, r in enumerate(chunk):
            x0 = sum(ws[:j]) + j + 1
            TILES.append(dict(sid=r["sid"], idx=i + j, x0=x0, x1=x0 + ws[j] - 1, y0=y0, y1=y0 + len(tiles[0]) - 1))
        y0 += len(tiles[0])
        for ln in zip(*tiles):
            print(" ".join(ln))
    print(f"{D} ctx = last request input · window {'$CLAUDE_CTX_WINDOW' if WINDOW else '200k, 1M if peak>200k'} · -o once · -t table · -a all · -j json{Z}")

def _run(cmd, **kw):
    if os.environ.get("CS_DRY"):
        print("DRY", " ".join(map(str, cmd))[:300], file=sys.stderr)
        return subprocess.CompletedProcess(cmd, 0, "", "")
    return subprocess.run(cmd, **kw)

def focus(r):
    import re as _re
    pid = r.get("pid")
    if not (r.get("live") and pid): return "session not running"
    try:
        ps = subprocess.check_output(["ps", "-axo", "pid=,ppid=,command="], text=True)
    except Exception as e:
        return f"ps failed: {e}"
    info = {}
    for ln in ps.splitlines():
        parts = ln.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            info[int(parts[0])] = (int(parts[1]), parts[2])
    chain, cur = [], pid
    while cur in info and len(chain) < 40:
        ppid, cmd = info[cur]
        chain.append(cmd)
        if ppid <= 1: break
        cur = ppid
    apps = []
    for c in chain:
        m = _re.search(r"/([^/]+)\.app/", c)
        if m and m.group(1) not in apps: apps.append(m.group(1))
    if r.get("entry") == "claude-vscode" or ".vscode/extensions" in chain[0]:
        app = "Cursor" if ".cursor" in chain[0] else "Visual Studio Code"
    else:
        app = next((a for a in apps if a not in ("Claude",)), None)
        if not app: return "terminal app not found"
    cwd = r.get("cwd") or ""
    if app in ("Visual Studio Code", "Cursor", "Code", "Windsurf") or "Code" in app:
        name = {"Code": "Visual Studio Code"}.get(app, app)
        _run(["open", "-a", name] + ([cwd] if os.path.isdir(cwd) else []), timeout=8)
        return f"focused {name} → {os.path.basename(cwd)}"
    try:
        tty = subprocess.check_output(["ps", "-p", str(pid), "-o", "tty="], text=True).strip()
    except Exception:
        tty = ""
    dev = f"/dev/{tty}" if tty and tty != "??" else ""
    script = None
    if app == "Terminal" and dev:
        script = f'''tell application "Terminal"
activate
repeat with w in windows
repeat with t in tabs of w
if tty of t is "{dev}" then
set selected of t to true
set index of w to 1
return "ok"
end if
end repeat
end repeat
end tell'''
    elif app.startswith("iTerm") and dev:
        script = f'''tell application "iTerm"
activate
repeat with w in windows
repeat with t in tabs of w
repeat with s in sessions of t
if tty of s is "{dev}" then
select w
select t
select s
return "ok"
end if
end repeat
end repeat
end repeat
end tell'''
    if script:
        res = _run(["osascript", "-e", script], capture_output=True, text=True, timeout=10)
        if res.returncode == 0: return f"focused {app} tab {tty}"
        return f"{app}: {res.stderr.strip()[:80] or 'osascript failed'}"
    _run(["open", "-a", app], timeout=8)
    return f"focused {app} (this app can't select a specific tab)"

def find_repos():
    found = []
    for root in REPO_ROOTS:
        base = root.count("/")
        for dp, dns, fns in os.walk(root):
            if ".git" in dns or ".git" in fns:
                found.append(dp); dns[:] = []; continue
            if dp.count("/") - base >= 3: dns[:] = []
            dns[:] = [x for x in dns if not x.startswith(".") and x not in ("node_modules", "vendor")]
    return sorted(set(found))[:400]

def chat_system():
    return ("You are the command bar of the user's claude-sessions terminal dashboard on macOS, separate from their "
        "coding sessions. The user types short requests such as \"open repo x in VS Code\" or \"show y in Finder\". "
        "Carry them out, then answer in one short plain-text line without markdown.\n"
        "Commands: VS Code `open -a \"Visual Studio Code\" <dir>` · Finder `open <dir>` (a file: `open -R <file>`) · "
        "Warp `open -a Warp <dir>` · a URL `open <url>`.\n"
        "Match repo names loosely (case, dashes, partial names) against the list below; if two match equally, ask "
        "which one.\n"
        "Git repos on this machine:\n" + "\n".join(REPOS or ["(none found)"]))

def chat_send(text, rows):
    global CHAT_SID, CHAT_PROC, REPOS, CHAT_T0
    if text == "/clear":
        CHAT.clear(); CHAT_SID = None
        return
    if CHAT_PROC:
        CHAT.append(("err", "still working on the previous request"))
        return
    import threading, uuid
    if REPOS is None: REPOS = find_repos()
    os.makedirs(CHAT_DIR, exist_ok=True)
    live = "\n".join(f"- {r['name'] or r['sid'][:8]} · {r['status']} · {r['cwd']}" for r in rows if r["live"])
    prompt = f"<dashboard>\nLive Claude sessions (name · status · dir):\n{live or '- none'}\n</dashboard>\n\n{text}"
    resume = bool(CHAT_SID and transcript(CHAT_SID))
    CHAT_SID = CHAT_SID or str(uuid.uuid4())
    cmd = [shutil.which("claude") or os.path.expanduser("~/.local/bin/claude"), "-p", prompt,
        "--model", CHAT_MODEL, "--permission-mode", "bypassPermissions", "--output-format", "stream-json", "--verbose",
        "--append-system-prompt", chat_system(), "--resume" if resume else "--session-id", CHAT_SID]
    CHAT.append(("you", text))
    CHAT_T0 = time.time()
    try:
        CHAT_PROC = subprocess.Popen(cmd, cwd=CHAT_DIR, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, text=True, start_new_session=True)
    except OSError as e:
        CHAT.append(("err", f"cannot start claude: {e}"))
        return
    threading.Thread(target=chat_read, args=(CHAT_PROC,), daemon=True).start()

def chat_read(p):
    global CHAT_PROC
    replied, noise = False, []
    for line in p.stdout:
        try: d = json.loads(line)
        except Exception:
            if line.strip(): noise.append(line.strip())
            continue
        t = d.get("type")
        if t == "assistant":
            for x in d.get("message", {}).get("content") or []:
                if x.get("type") == "text" and x.get("text", "").strip():
                    CHAT.append(("claude", x["text"].strip())); replied = True
                elif x.get("type") == "tool_use":
                    inp = x.get("input") or {}
                    arg = next((v for v in inp.values() if isinstance(v, str)), "")
                    CHAT.append(("tool", f"$ {inp['command']}" if inp.get("command") else f"{x.get('name', '').split('__')[-1]} {arg}"))
        elif t == "user":
            for x in d.get("message", {}).get("content") or []:
                if isinstance(x, dict) and x.get("type") == "tool_result" and x.get("is_error"):
                    c = x.get("content")
                    if isinstance(c, list): c = " ".join(y.get("text", "") for y in c if isinstance(y, dict))
                    CHAT.append(("err", str(c)[:300]))
        elif t == "result" and d.get("is_error"):
            CHAT.append(("err", str(d.get("result") or d.get("subtype") or "request failed"))); replied = True
    p.wait()
    if p.returncode and not replied:
        CHAT.append(("err", noise[-1] if noise else f"claude exited with code {p.returncode}"))
    CHAT_PROC = None

def chat_view(cols):
    import textwrap
    T = lambda n: f"\033[38;5;{n}m"
    Z, B, D = "\033[0m", "\033[1m", "\033[2m"
    ORANGE, GRAY, RED, FG, MID, UBG = T(173), T(240), T(167), T(253), T(245), "\033[48;5;236m"
    on = INPUT is not None
    W = max(30, cols - 1)
    inner = W - 4
    bd = ORANGE if on else GRAY
    home = os.path.expanduser("~")
    log = []
    for kind, text in CHAT:
        if kind == "tool":
            cmd = (str(text).splitlines() or [""])[0].replace(home, "~")
            log.append(f"  {GRAY}⎿{Z}  {MID}{clip(cmd, inner - 5)}{Z}")
            continue
        for i, seg in enumerate(textwrap.wrap(" ".join(str(text).split()), inner - 3) or [""]):
            first = i == 0
            if kind == "you":
                log.append(f"{UBG}{FG}" + pad(f" {'›' if first else ' '} {seg}", inner) + Z)
            elif kind == "claude":
                log.append(f"{ORANGE}{'⏺' if first else ' '}{Z} {FG}{seg}{Z}")
            else:
                log.append(f"{RED}{'✗' if first else ' '} {seg}{Z}")
    if CHAT_PROC:
        log.append(f"{ORANGE}{'·✢✳✶✻✽✻✶✳✢'[FRAME % 10]} Working…{Z} {D}{int(time.time() - CHAT_T0)}s{Z}")
    tip = "open a repo in VS Code, show it in Finder…"
    if not on:
        field = f"{GRAY}❯{Z} {D}{clip('press / to ask Claude · ' + tip, inner - 2)}{Z}"
    elif INPUT:
        room = inner - 3
        cur = "\033[7m \033[27m" if FRAME // 3 % 2 == 0 else " "
        field = f"{ORANGE}{B}❯{Z} {FG}{B}{INPUT[-room:] if vw(INPUT) > room else INPUT}{Z}{cur}"
    else:
        cur = "\033[7m \033[27m" if FRAME // 3 % 2 == 0 else " "
        field = f"{ORANGE}{B}❯{Z} {cur}{D}{clip(tip, inner - 3)}{Z}"
    head = f"{bd}╭─{Z} {ORANGE}{B}✻ Ask Claude{Z} "
    side = f" {D}{CHAT_MODEL} · {'enter send · esc close' if on else '/ to type'}{Z} {bd}─╮{Z}"
    row = lambda x: f"{bd}│{Z} {pad(x, inner)} {bd}│{Z}"
    out = [head + f"{bd}{'─' * max(0, W - vw(head) - vw(side))}{Z}" + side]
    if log:
        out += [row(x) for x in log[-CHAT_ROWS:]] + [f"{bd}├{'─' * (W - 2)}┤{Z}"]
    return out + [row(field), f"{bd}╰{'─' * (W - 2)}╯{Z}"]

def serve(port, fixed):
    import threading, secrets
    from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
    from urllib.parse import urlparse, parse_qs
    root = os.path.dirname(os.path.realpath(os.environ.get("CS_SELF") or "."))
    web = os.path.join(root, "web")
    page = os.path.join(web, "index.html")
    theme_cfg = os.path.join(root, ".theme-config.json")
    STATIC = {"/manifest.webmanifest": "application/manifest+json", "/sw.js": "text/javascript; charset=utf-8"}
    token = secrets.token_urlsafe(24)
    cache, lock, tlock = {}, threading.Lock(), threading.Lock()

    def sessions(ended, fresh=False):
        with lock:
            t, rows = cache.get(ended, (0, []))
            if fresh or time.time() - t >= 2:
                rows = collect(ended)
                cache[ended] = (time.time(), rows)
            return rows

    def themes():
        try: c = json.load(open(theme_cfg, encoding="utf-8"))
        except (OSError, ValueError): c = {}
        if not isinstance(c, dict): c = {}
        lst = [dict(id=str(t["id"]), title=str(t.get("title") or t["id"]), file=t["file"]) for t in c.get("themes") or []
               if isinstance(t, dict) and t.get("id") and re.fullmatch(r"[A-Za-z0-9_-]+\.css", str(t.get("file", "")))]
        lst = lst or [dict(id="terminal", title="Terminal", file="Terminal-theme.css")]
        cur = next((t for t in lst if t["id"] == c.get("selected")), lst[0])
        return c, lst, cur

    def chat_state():
        return dict(log=[list(x) for x in CHAT], working=CHAT_PROC is not None, t0=CHAT_T0)

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a): pass

        def reply(self, code, body, ctype="application/json; charset=utf-8"):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            try:
                self.send_response(code)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.send_header("Content-Security-Policy", "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'")
                self.end_headers()
                self.wfile.write(data)
            except OSError:
                pass

        def allowed(self, api):
            p = self.server.server_address[1]
            if self.headers.get("Host") not in (f"127.0.0.1:{p}", f"localhost:{p}"):
                self.reply(403, {"error": "bad host"}); return False
            if api and not secrets.compare_digest(self.headers.get("X-CS-Token", ""), token):
                self.reply(403, {"error": "bad token"}); return False
            return True

        def do_GET(self):
            u = urlparse(self.path)
            if not self.allowed(u.path.startswith("/api/")): return
            if u.path == "/":
                try: html = open(page, encoding="utf-8").read()
                except OSError as e: return self.reply(500, f"cannot read {page}: {e}".encode(), "text/plain; charset=utf-8")
                html = html.replace("__CS_TOKEN__", token).replace("__CS_THEME__", f"/themes/{themes()[2]['file']}")
                return self.reply(200, html.encode(), "text/html; charset=utf-8")
            ctype = (STATIC.get(u.path) or ("image/png" if re.fullmatch(r"/icons/[a-z0-9-]+\.png", u.path) else None)
                or ("text/css; charset=utf-8" if re.fullmatch(r"/themes/[A-Za-z0-9_-]+\.css", u.path) else None))
            if ctype:
                try: data = open(os.path.join(web, u.path.lstrip("/")), "rb").read()
                except OSError: return self.reply(404, {"error": "not found"})
                return self.reply(200, data, ctype)
            if u.path == "/api/state":
                q = parse_qs(u.query)
                rows = sessions(q.get("all") == ["1"], q.get("fresh") == ["1"])
                _, lst, cur = themes()
                return self.reply(200, dict(sessions=rows, usage=usage_data(), chat=chat_state(), now=time.time(),
                    cfg=dict(themes=lst, theme=cur["id"], window=WINDOW, agent_rows=AGENT_ROWS, chat_rows=CHAT_ROWS, chat_model=CHAT_MODEL, home=os.path.expanduser("~"))))
            self.reply(404, {"error": "not found"})

        def do_POST(self):
            u = urlparse(self.path)
            if not self.allowed(True): return
            try:
                n = int(self.headers.get("Content-Length") or 0)
                body = json.loads(self.rfile.read(min(n, 65536)) or b"{}") if n else {}
            except (ValueError, OSError):
                return self.reply(400, {"error": "bad body"})
            if u.path == "/api/focus":
                sid = body.get("sid")
                with lock:
                    row = next((r for _, rows in cache.values() for r in rows if r["sid"] == sid), None)
                return self.reply(200, {"msg": focus(row) if row else "session not found"})
            if u.path == "/api/theme":
                with tlock:
                    c, lst, _ = themes()
                    t = next((t for t in lst if t["id"] == body.get("id")), None)
                    if not t: return self.reply(400, {"error": "unknown theme"})
                    c["themes"] = c.get("themes") or lst
                    c["selected"] = t["id"]
                    tmp = theme_cfg + ".tmp"
                    try:
                        with open(tmp, "w", encoding="utf-8") as f: f.write(json.dumps(c, indent=2, ensure_ascii=False) + "\n")
                        os.replace(tmp, theme_cfg)
                    except OSError as e:
                        return self.reply(500, {"error": f"cannot write {theme_cfg}: {e.strerror}"})
                return self.reply(200, {"theme": t["id"]})
            if u.path == "/api/chat":
                text = str(body.get("text") or "").strip()
                if text: chat_send(text, sessions(False))
                return self.reply(200, chat_state())
            self.reply(404, {"error": "not found"})

    try:
        srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    except OSError as e:
        if fixed: sys.exit(f"claude-sessions: cannot listen on 127.0.0.1:{port}: {e.strerror}")
        srv = ThreadingHTTPServer(("127.0.0.1", 0), H)
    srv.daemon_threads = True
    if not os.path.isfile(page): print(f"warning: {page} not found", file=sys.stderr)
    print(f"claude-sessions web: http://127.0.0.1:{srv.server_address[1]}  (ctrl-c to stop)", flush=True)
    try: srv.serve_forever()
    except KeyboardInterrupt: pass
    finally:
        if CHAT_PROC: CHAT_PROC.terminate()
        srv.server_close()

once = any(a in ("-o", "--once") for a in args)
serve_at = next((i for i, a in enumerate(args) if a in ("-s", "--serve")), None)
if serve_at is not None:
    nxt = args[serve_at + 1] if serve_at + 1 < len(args) else ""
    port = nxt if nxt.isdigit() else os.environ.get("CS_PORT", "")
    serve(int(port) if port.isdigit() else 7421, port.isdigit())
elif as_json or table or once or not sys.stdout.isatty():
    watch = False
    render(collect())
    if not (as_json or table):
        print(usage_line(0))
else:
    import io, select, termios, tty, contextlib
    watch = True
    out = sys.stdout
    try: kb = open("/dev/tty")
    except OSError: kb = None
    fd = kb.fileno() if kb else None
    old = termios.tcgetattr(fd) if kb else None
    out.write("\033[?1049h\033[?25l\033[?1000h\033[?1006h")
    out.flush()
    try:
        if old: tty.setcbreak(fd)
        last = 0
        data = []
        while True:
            if time.time() - last >= 2:
                data = collect()
                last = time.time()
            if True:
                FRAME += 1
                buf = io.StringIO()
                with contextlib.redirect_stdout(buf):
                    render(data)
                lines = buf.getvalue().rstrip("\n").split("\n")
                sz = shutil.get_terminal_size((120, 30))
                h = sz.lines
                if INPUT is None:
                    hint = "\033[2m ←↑↓→ select · enter/click focus · / chat · q quit · a " + ("hide ended" if show_all else "show ended") + " · r refresh \033[0m"
                else:
                    hint = "\033[2m enter send · esc close chat · ctrl-u clear line · /clear new chat \033[0m"
                if MSG[0] and time.time() - MSG[1] < 5: hint += "  \033[38;5;173m▸ " + MSG[0] + "\033[0m"
                chat = chat_view(sz.columns)
                bottom = chat + [usage_line(0), hint]
                body = lines[:max(1, h - len(bottom) - 1)]
                BODY_H, CHAT_Y = len(body), (h - len(bottom) + 1, h - 2)
                out.write("\033[H" + "".join(l + "\033[K\n" for l in body) + "\033[J"
                    + "".join(f"\033[{h - len(bottom) + 1 + i};1H{l}\033[K" for i, l in enumerate(bottom)))
                out.flush()
            r, _, _ = select.select([kb], [], [], 0.15) if old else (time.sleep(0.15), ([], 0, 0))[1]
            if r:
                import re as _re
                raw = os.read(fd, 4096).decode(errors="ignore")
                events = []
                for m in _re.finditer(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", raw):
                    if m.group(4) == "M" and int(m.group(1)) == 0:
                        events.append(("click", int(m.group(2)), int(m.group(3))))
                rest = _re.sub(r"\x1b\[<[0-9;]+[Mm]", "", raw)
                for m in _re.finditer(r"\x1b[\[O]([0-9;]*)([A-Za-z~])|(.)", rest, _re.S):
                    if m.group(2):
                        if not m.group(1) and m.group(2) in "ABCD": events.append(("arrow", m.group(2)))
                    else: events.append(("key", m.group(3)))
                done = False
                for ev in events:
                    if INPUT is not None and ev[0] != "click":
                        k = ev[1] if ev[0] == "key" else ""
                        if k == "\x03": done = True
                        elif k in ("\x1b", "\t"): INPUT = None
                        elif k in ("\r", "\n"):
                            if INPUT.strip(): chat_send(INPUT.strip(), data)
                            INPUT = ""
                        elif k in ("\x7f", "\x08"): INPUT = INPUT[:-1]
                        elif k == "\x15": INPUT = ""
                        elif k.isprintable(): INPUT += k
                        continue
                    if ev[0] == "click":
                        if CHAT_Y[0] <= ev[2] <= CHAT_Y[1]:
                            INPUT = INPUT or ""
                            continue
                        INPUT = None
                        hit = next((t for t in TILES if t["x0"] <= ev[1] <= t["x1"] and t["y0"] <= ev[2] <= min(t["y1"], BODY_H)), None)
                        if hit:
                            SEL = hit["sid"]
                            row = next((x for x in data if x["sid"] == SEL), None)
                            if row: MSG = (focus(row), time.time())
                    elif ev[0] == "arrow":
                        if not data: continue
                        ids = [x["sid"] for x in data]
                        cur = ids.index(SEL) if SEL in ids else -1
                        per_row = max(1, len({t["x0"] for t in TILES}))
                        d = {"C": 1, "D": -1, "B": per_row, "A": -per_row}[ev[1]]
                        cur = 0 if cur < 0 else min(len(ids) - 1, max(0, cur + d))
                        SEL = ids[cur]
                    else:
                        k = ev[1]
                        if k in ("q", "Q", "\x03"): done = True
                        elif k == "\x1b": done = True
                        elif k in ("/", "\t"): INPUT = ""
                        elif k in ("a", "A"): show_all = not show_all; last = 0
                        elif k in ("r", "R"): last = 0
                        elif k in ("\r", "\n", " "):
                            row = next((x for x in data if x["sid"] == SEL), None)
                            if row: MSG = (focus(row), time.time())
                            else: MSG = ("select a session with the arrow keys first", time.time())
                if done: break
    except KeyboardInterrupt:
        pass
    finally:
        if CHAT_PROC: CHAT_PROC.terminate()
        if old: termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write("\033[?1000l\033[?1006l\033[?25h\033[?1049l")
        out.flush()

